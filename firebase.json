{
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html",
        "exclude": [
          "/manifest.json",
          "/favicon.ico",
          "/favicon.png",
          "/assets/**",
          "/icons/**",
          "/canvaskit/**",
          "/flutter.js",
          "/flutter_bootstrap.js"
        ]
      }
    ]
  }
}